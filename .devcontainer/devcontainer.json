{
	"name": "Storitch",
	"build": {
		"context": "..",
		"dockerfile": "../Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/va-h/devcontainers-features/uv:1": {
			"version": "0.11.19",
			"shellautocompletion": false
		}
	},
	"remoteUser": "storitch",
	"updateRemoteUserUID": true,
	"containerEnv": {
		"STORITCH__API_KEYS": "[\"test\"]",
		"STORITCH__DEBUG": "true",
		"UV_LINK_MODE": "copy"
	},
	"remoteEnv": {
		"PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
	},
	"forwardPorts": [3000],
	"portsAttributes": {
		"3000": {
			"label": "Storitch API",
			"onAutoForward": "notify"
		}
	},
	"customizations": {
		"zed": {}
	},
	"postCreateCommand": "uv sync --locked --all-groups",
	"shutdownAction": "stopContainer"
}
